---
import {type CollectionEntry, getCollection, render} from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
    post: CollectionEntry<"notes">
}

export async function getStaticPaths() {
    const posts = await getCollection("notes");
    return posts.map((post) => ({
        params: {id: post.id}, // id будет передан в Astro.params
        props: {post}, // можно передать данные напрямую (опционально)
    }));
}

const {post} = Astro.props;
const {Content} = await render(post)
---
<BaseLayout
        description={post.data.description || "Личный блог Александра Провоторова"}
        title={post.data.title}
>
    <h1>{post.data.title}</h1>
    <time datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString("ru-RU")}
    </time>
    <Content/>
</BaseLayout>