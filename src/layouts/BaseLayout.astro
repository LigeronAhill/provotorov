---
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import "@/styles/base.css";
import {Font} from "astro:assets";
import {ClientRouter} from "astro:transitions";

interface Props {
    title: string;
    description: string;
}

const props = Astro.props;
---
<html lang="ru">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="generator" content={Astro.generator}/>
    <link rel="icon" type="image/png" href="/favicons/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="48x48" href="/favicons/favicon-48x48.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/favicons/favicon-72x72.png">
    <link rel="apple-touch-icon" sizes="96x96" href="/favicons/favicon-96x96.png">
    <link rel="apple-touch-icon" sizes="256x256" href="/favicons/favicon-256x256.png">
    <link rel="apple-touch-icon" sizes="384x384" href="/favicons/favicon-384x384.png">
    <link rel="apple-touch-icon" sizes="512x512" href="/favicons/favicon-512x512.png">
    <link rel="manifest" href="/favicons/manifest.webmanifest" crossorigin="anonymous">
    <title>{props.title} | Провоторов</title>
    <meta name="description" content={props.description}>
    <Font cssVariable="--font-sofia-sans" preload/>
    <Font cssVariable="--font-pt-serif" preload/>
    <Font cssVariable="--font-pt-sans" preload/>
    <ClientRouter/>
</head>
<body>
<Header/>
<main>
    <slot/>
</main>
<Footer/>
</body>
</html>

<style>
    body {
        display: grid;
        grid-template-rows: auto 1fr auto;
        min-height: 100svh;
    }

    main {
        margin-inline: auto;
        width: 100%;
        max-width: var(--max-width);
        padding: 1rem;
    }
</style>