<style>
    footer {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--color-base-dark);
        padding: 1rem;

        nav {
            width: 100%;
            max-width: var(--max-width);
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            align-items: center;
            justify-content: center;

            section {
                padding-inline: 2rem;
                padding-bottom: 2rem;
                width: 100%;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;

                h5 {
                    width: 100%;
                    text-align: center;
                }
            }

            section:nth-child(2) {
                border-left: 1px solid var(--color-base-300);
                border-right: 1px solid var(--color-base-300);
            }


            ul {
                width: 100%;
                margin: 0;
                padding: 0;
                list-style: none;
                display: flex;
                flex-direction: column;
                gap: 1rem;
                align-items: center;
                justify-content: center;

                li {
                    width: 100%;
                }
            }
        }

        @media screen and (width < 640px) {
            nav {
                flex-direction: column;
                justify-content: center;
            }
        }
    }

</style>